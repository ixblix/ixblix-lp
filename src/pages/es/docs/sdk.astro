  <Endpoint method="POST" path="/companies/payment-change/start" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.startPaymentChange({
  planId?: string,
}): Promise<StartPaymentChangeResult>

// Returns { transactionId, provider, amountCents, currency,
