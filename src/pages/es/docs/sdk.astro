---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import PageNav from '../../../components/PageNav.astro';
import { t } from '../../../i18n';
import type { Locale } from '../../../i18n/config';

const locale: Locale = 'es';
---

<DocsLayout>
  <h1>{t(locale, 'nav.sdk')}</h1>
  <p class="lead">Paquete oficial <code>@ixblix/sdk-js</code> TypeScript con cliente HTTP tipado, auxiliares de criptografía y verificación de webhooks.</p>

  <h2>Instalación</h2>
  <CodeBlock language="bash" code="npm install @ixblix/sdk-js" title="npm" />

  <h2>Configuración del Cliente</h2>
  <CodeBlock language="typescript" code={`import { IxblixClient, loadOrCreateOperatorKey } from '@ixblix/sdk-js';

const operatorKey = await loadOrCreateOperatorKey({ path: './keys/operator.json' });

// Cliente en el ámbito del integrador
const integratorClient = new IxblixClient({
  baseUrl: 'https://api.ixblix.app',
  integratorId: 'int_xxxx',
  integratorAccessToken: 'ixblix_integrator_token_xxxx',
});

// Cliente en el ámbito de la empresa
const companyClient = new IxblixClient({
  baseUrl: 'https://api.ixblix.app',
  apiKey: 'smci_xxxx',
  operatorKey,
});`} title="TypeScript" />

  <h2>Métodos del Integrador</h2>
  <CodeBlock language="typescript" code={`// Planes
const plans = await integratorClient.listPlans();

// Registro de empresa
const { company, payment } = await integratorClient.registerCompany({ name, handle, planId });

// Activación de empresa
const { apiKey } = await integratorClient.activateCompany(company.id, payment.transactionId);`} title="TypeScript" />

  <h2>Métodos de la Empresa</h2>
  <CodeBlock language="typescript" code={`// Webhook
const { webhookSecret } = await companyClient.updateWebhook({ webhookUrl });

// Clave de cifrado
await companyClient.registerEncryptionKey({ keyId, publicKey });

// Conversaciones
const { conversation, deeplink } = await companyClient.createConversation({
  contact: { externalId, name, metadata },
});

// Mensajes
const envelope = encryptToRecipient('¡Hola!', customerPublicKeySpki, operatorKey.keyId, operatorKey.publicKeySpki);
await companyClient.sendCompanyMessage(conversationId, envelope);

// Acuses de lectura
await companyClient.markMessageReadByCompany(conversationId, messageId);

// Presencia
await companyClient.reportCompanyPresence(conversationId, 'typing');`} title="TypeScript" />

  <h2>Auxiliares de Criptografía</h2>
  <CodeBlock language="typescript" code={`import {
  generateOperatorKeyPair,
  loadOrCreateOperatorKey,
  encryptToRecipient,
  decryptEnvelope,
  encryptRichMessage,
  decryptAttachments,
  encryptMediaToRecipient,
  decryptMediaEnvelope,
} from '@ixblix/sdk-js';

// Generar o cargar par de claves
const operatorKey = await loadOrCreateOperatorKey({
  path: './keys/operator.json',
});

// Cifrar texto
const envelope = encryptToRecipient(
  '¡Hola!',
  customerPublicKeySpki,
  operatorKey.keyId,
  operatorKey.publicKeySpki,
);

// Descifrar mensaje de texto
const plaintext = decryptEnvelope(message, operatorKey.privateKey);

// Cifrar mensaje rico (botones, vcard, ubicación)
const richEnvelope = encryptRichMessage(
  'Confirme su pedido:',
  { buttons: [{ type: 'reply', label: 'Sí' }] },
  customerPublicKeySpki,
  operatorKey.keyId,
  operatorKey.publicKeySpki,
);

// Cifrar/descifrar medios
const mediaEnvelope = encryptMediaToRecipient(fileBuffer, customerPublicKeySpki, operatorKey.keyId, operatorKey.publicKeySpki);
const decrypted = decryptMediaEnvelope(encryptedData, message, operatorKey.privateKey);`} title="TypeScript" />

  <h2>Verificación de Webhooks</h2>
  <CodeBlock language="typescript" code={`import { verifyWebhook, WEBHOOK_SIGNATURE_HEADER } from '@ixblix/sdk-js';

app.post('/webhooks', (req, res) => {
  const signature = req.header(WEBHOOK_SIGNATURE_HEADER);
  const { event } = verifyWebhook(req.body, webhookSecret, signature);
  // Manejar evento...
  res.status(200).send('OK');
});`} title="TypeScript" />

  <PageNav
    prev={{ titleKey: 'nav.errors', path: 'errors' }}
  />
</DocsLayout>
