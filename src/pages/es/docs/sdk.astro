// Redirect the company owner to checkoutUrl.`} title="startPaymentChange" />

  <h3>Company methods — original channel relay</h3>

  <Endpoint method="POST" path="/webhooks/original-channel" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.relayOriginalChannelMessage({
  conversationId: string,
  content: string, // base64 ciphertext
  iv: string,
  authTag: string,
  encryptedKey: string,
  selfEncryptedKey: string,
  keyId: string,
  metadata?: Record<string, unknown>,
}): Promise<Message>

// Relay a message from WhatsApp/Instagram/etc. into ixblix.
// The message must be encrypted to the operator's public key.`} title="relayOriginalChannelMessage" />

  <h2 id="crypto">Crypto helpers</h2>
  <p>
    End-to-end encryption uses hybrid RSA-OAEP + AES-256-GCM. Each message gets a fresh AES key,
    wrapped to both the recipient and the sender (so you can read back your own messages).
  </p>

  <h3>generateOperatorKeyPair</h3>
  <CodeBlock language="typescript" code={`import { generateOperatorKeyPair } from '@ixblix/sdk-js';

const keypair = generateOperatorKeyPair({
  modulusLength?: 2048 | 4096, // default 2048
}): OperatorKeyPair

// Returns { keyId, publicKeySpki, privateKey }.
// The private key never leaves your process.`} title="generateOperatorKeyPair" />

  <h3>importPublicKey</h3>
  <CodeBlock language="typescript" code={`import { importPublicKey } from '@ixblix/sdk-js';

const key = importPublicKey(spkiBase64: string): KeyObject

// Import a base64 SPKI DER RSA public key (e.g. the customer's key).`} title="importPublicKey" />

  <h3>encryptToRecipient</h3>
  <CodeBlock language="typescript" code={`import { encryptToRecipient } from '@ixblix/sdk-js';

const envelope = encryptToRecipient(
  plaintext: string,
  recipientPublicKeySpki: string,
  senderKeyId: string,
  senderPublicKeySpki: string,
): MessageEnvelope

// Returns { content, iv, authTag, encryptedKey, selfEncryptedKey, keyId }.
// All fields are base64url-encoded.`} title="encryptToRecipient" />

  <h3>decryptEnvelope</h3>
  <CodeBlock language="typescript" code={`import { decryptEnvelope } from '@ixblix/sdk-js';

const plaintext = decryptEnvelope(
  envelope: { content, iv?, authTag?, encryptedKey?, selfEncryptedKey? },
  privateKey: KeyObject,
): string | null

// Tries encryptedKey first, then selfEncryptedKey.
// Returns null when decryption fails.`} title="decryptEnvelope" />

  <h3>encryptRichMessage</h3>
  <CodeBlock language="typescript" code={`import { encryptRichMessage } from '@ixblix/sdk-js';

const result = encryptRichMessage(
  content: string,
  attachments: string | null, // JSON with buttons, vcard, location, linkPreview
  recipientPublicKeySpki: string,
  senderKeyId: string,
  senderPublicKeySpki: string,
): {
  content: string,
  attachments: string | null, // encrypted blob
  iv: string,
  authTag: string,
  encryptedKey: string,
  selfEncryptedKey: string,
  keyId: string,
}

// Encrypts content and attachments with different IVs but the same AES key.
// The attachments blob embeds its own iv and authTag.`} title="encryptRichMessage" />

  <h3>decryptAttachments</h3>
  <CodeBlock language="typescript" code={`import { decryptAttachments } from '@ixblix/sdk-js';

const json = decryptAttachments(
  attachmentsBlob: string,
  envelope: { encryptedKey?, selfEncryptedKey? },
  privateKey: KeyObject,
): string | null

// Decrypts the attachments blob from a rich message.
// Returns the JSON string or null.`} title="decryptAttachments" />

  <h3>encryptMediaToRecipient</h3>
  <CodeBlock language="typescript" code={`import { encryptMediaToRecipient } from '@ixblix/sdk-js';

const envelope = encryptMediaToRecipient(
  fileBytes: Uint8Array,
  recipientPublicKeySpki: string,
  senderKeyId: string,
  senderPublicKeySpki: string,
): MessageEnvelope

// Encrypts binary media (image/audio/document).
// Returns the envelope fields; the ciphertext is in envelope.content.`} title="encryptMediaToRecipient" />

  <h3>encryptMediaWithAttachments</h3>
  <CodeBlock language="typescript" code={`import { encryptMediaWithAttachments } from '@ixblix/sdk-js';

const result = encryptMediaWithAttachments(
  fileBytes: Uint8Array,
  attachments: string, // JSON
  recipientPublicKeySpki: string,
  senderKeyId: string,
  senderPublicKeySpki: string,
): {
  content: string,
  iv: string,
  authTag: string,
  encryptedKey: string,
  selfEncryptedKey: string,
  keyId: string,
  encryptedAttachments: string,
}

// Use this when sending media + rich attachments.
// Both share the same AES key so the recipient can decrypt both.`} title="encryptMediaWithAttachments" />

  <h3>decryptMediaEnvelope</h3>
  <CodeBlock language="typescript" code={`import { decryptMediaEnvelope } from '@ixblix/sdk-js';

const bytes = decryptMediaEnvelope(
  envelope: { content, iv?, authTag?, encryptedKey?, selfEncryptedKey? },
  privateKey: KeyObject,
): Uint8Array | null

// Decrypts a media file. Returns the plaintext bytes or null.`} title="decryptMediaEnvelope" />

  <h2 id="keypair">Keypair persistence</h2>

  <h3>loadOrCreateOperatorKey</h3>
  <CodeBlock language="typescript" code={`import { loadOrCreateOperatorKey } from '@ixblix/sdk-js';

const keypair = loadOrCreateOperatorKey(directory: string): OperatorKeyPair

// Loads the keypair from disk, or generates and persists it on first run.
// Files: operator-private.pem (mode 0600), operator-public.spki, operator-key-id.
// For production, use a secret manager or KMS instead.`} title="loadOrCreateOperatorKey" />

  <h2 id="webhooks">Webhook verification</h2>
  <p>
    ixblix signs every webhook with HMAC-SHA256 using the company's webhook secret.
    Always verify the signature before acting on the event.
  </p>

  <h3>Constants</h3>
  <CodeBlock language="typescript" code={`import {
  WEBHOOK_SIGNATURE_HEADER,   // 'X-Ixblix-Signature'
  WEBHOOK_ID_HEADER,           // 'X-Ixblix-Event-Id'
  WEBHOOK_EVENT_HEADER,        // 'X-Ixblix-Event'
  WEBHOOK_COMPANY_ID_HEADER,   // 'X-Ixblix-Company-Id'
} from '@ixblix/sdk-js';`} title="Webhook headers" />

  <h3>verifyWebhook</h3>
  <CodeBlock language="typescript" code={`import { verifyWebhook } from '@ixblix/sdk-js';

const { event, raw } = verifyWebhook(
  body: unknown,
  secret: string,
  signature?: string,
): ParsedWebhook

// Computes HMAC-SHA256 of the raw body and compares it (constant-time)
// against the signature. Throws on mismatch.
// Returns the typed event (WebhookEvent union).`} title="verifyWebhook" />

  <h3>parseWebhook</h3>
  <CodeBlock language="typescript" code={`import { parseWebhook } from '@ixblix/sdk-js';

const { event, raw } = parseWebhook(body: unknown): ParsedWebhook

// Parses and validates the event type without checking the signature.
// Use only when you trust the source (e.g. internal relay).`} title="parseWebhook" />

  <h3>Webhook event types</h3>
  <table>
    <thead><tr><th>Event</th><th>Payload</th></tr></thead>
    <tbody>
      <tr><td><code>COMPANY_ACTIVATED</code></td><td>{'{ companyId, transactionId, apiKey }'}</td></tr>
      <tr><td><code>CUSTOMER_JOINED</code></td><td>{'{ companyId, conversationId, customerPublicKey }'}</td></tr>
      <tr><td><code>MESSAGE_RECEIVED</code></td><td>{'{ companyId, conversationId, messageId, replyToId?, sentAt }'}</td></tr>
      <tr><td><code>MESSAGE_READ</code></td><td>{'{ companyId, conversationId, messageId, readAt }'}</td></tr>
      <tr><td><code>CONVERSATION_CLOSED</code></td><td>{'{ companyId, conversationId }'}</td></tr>
      <tr><td><code>TYPING</code> / <code>STOPPED_TYPING</code> / <code>RECORDING</code> / <code>CHAT_CLOSED</code></td><td>{'{ companyId, conversationId, type }'}</td></tr>
      <tr><td><code>BALANCE_LOW</code></td><td>{'{ companyId, balanceCents }'}</td></tr>
    </tbody>
  </table>

  <h2 id="errors">IxblixError</h2>
  <CodeBlock language="typescript" code={`import { IxblixError } from '@ixblix/sdk-js';

class IxblixError extends Error {
  readonly status: number; // HTTP status (0 if request never reached the API)
  readonly code: string;   // e.g. 'UNAUTHORIZED', 'NOT_FOUND'
  readonly details?: Array<{ path: string; message: string }>;
}

// Thrown by every client method when the API returns a non-2xx response.
// Catch and inspect error.code for programmatic handling.`} title="IxblixError" />

  <h2 id="types">Shared types</h2>
  <p>All types are exported from the package root. Key types:</p>
  <ul>
    <li><code>Contact</code>, <code>ContactInput</code> — customer identity</li>
    <li><code>Conversation</code>, <code>ConversationKeys</code> — thread state</li>
    <li><code>Message</code>, <code>MessageEnvelope</code>, <code>Media</code> — encrypted content</li>
    <li><code>Operator</code>, <code>OperatorInput</code> — agent identity</li>
    <li><code>CompanyProfile</code>, <code>CompanyCustomization</code> — white-label</li>
    <li><code>Plan</code>, <code>CompanyBalance</code>, <code>CreditPurchase</code> — billing</li>
    <li><code>PaymentMethod</code>, <code>PaymentChangeOptions</code> — payment instruments</li>
    <li><code>WebhookEvent</code> — union of all webhook payloads</li>
  </ul>

