---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import Endpoint from '../../../components/Endpoint.astro';
import PageNav from '../../../components/PageNav.astro';
import { t } from '../../../i18n';
import type { Locale } from '../../../i18n/config';

const locale: Locale = 'es';
---

<DocsLayout>
  <h1>{t(locale, 'nav.sdk')}</h1>
  <p class="lead">
    Complete reference for the official <code>@ixblix/sdk-js</code> TypeScript package.
    Covers every exported class, function, type and constant — with signatures, parameters,
    return values and runnable examples.
  </p>

  <div class="callout callout-info">
    <div class="callout-title">Package</div>
    <p><code>npm install @ixblix/sdk-js</code> — requires Node.js 18+. Ships ESM + CJS with full TypeScript declarations.</p>
  </div>

  <h2>Table of contents</h2>
  <ul>
    <li><a href="#client">IxblixClient — HTTP client</a></li>
    <li><a href="#crypto">Crypto helpers — E2EE</a></li>
    <li><a href="#keypair">Keypair persistence</a></li>
    <li><a href="#webhooks">Webhook verification</a></li>
    <li><a href="#errors">IxblixError</a></li>
    <li><a href="#types">Shared types</a></li>
  </ul>

  <h2 id="client">IxblixClient</h2>
  <p>Typed HTTP client for the ixblix REST API. One instance per scope — integrator or company.</p>

  <h3>Constructor</h3>
  <CodeBlock language="typescript" code={`import { IxblixClient } from '@ixblix/sdk-js';

const client = new IxblixClient({
  baseUrl: 'https://api.ixblix.app',
  apiKey?: string,              // X-API-Key header (company scope)
  integratorId?: string,        // HTTP Basic user (integrator scope)
  integratorAccessToken?: string,
  operatorKey?: OperatorKeyPair, // required to encrypt outgoing messages
  fetch?: typeof fetch,         // optional custom fetch
});`} title="IxblixClient" />

  <h3>Integrator methods</h3>

  <Endpoint method="POST" path="/integrators/register" auth="HTTP Basic" authType="integrator" />
  <CodeBlock language="typescript" code={`client.registerIntegrator({
  name: string,
  hostname: string,
  callbackUrl: string,
  force?: boolean,
  subscriptionId?: string,
}): Promise<RegisterIntegratorResult>

// Three-way handshake: ixblix POSTs a challenge to callbackUrl,
// your endpoint echoes the registration payload, then echoes the credentials.`} title="registerIntegrator" />

  <Endpoint method="GET" path="/plans" auth="HTTP Basic" authType="integrator" />
  <CodeBlock language="typescript" code={`client.listPlans(): Promise<Plan[]>

// Returns all active subscription plans (billingType, includedConversations,
// includedMessages, durationDays, priceCents, overagePriceCents).`} title="listPlans" />

  <Endpoint method="GET" path="/payment/providers" auth="HTTP Basic" authType="integrator" />
  <CodeBlock language="typescript" code={`client.listPaymentProviders(): Promise<PaymentProvidersResult>

// { providers: string[] } — e.g. ['asaas', 'stripe'].`} title="listPaymentProviders" />

  <Endpoint method="POST" path="/companies/register" auth="HTTP Basic" authType="integrator" />
  <CodeBlock language="typescript" code={`client.registerCompany({
  name: string,
  handle: string,
  planId?: string,
  confirmationWebhookUrl?: string,
  email?: string,
  taxId?: string,
}): Promise<RegisterCompanyResult>

// Returns { company, payment } where payment contains transactionId,
// checkoutUrl (for paid plans) and confirmationUrl.`} title="registerCompany" />

  <Endpoint method="POST" path="/companies/{id}/activate/{transactionId}" auth="HTTP Basic" authType="integrator" />
  <CodeBlock language="typescript" code={`client.activateCompany(
  companyId: string,
  transactionId: string,
): Promise<ActivateCompanyResult>

// Returns { apiKey, status }. Store the apiKey in a secret manager.`} title="activateCompany" />

  <h3>Company methods — profile &amp; customization</h3>

  <Endpoint method="GET" path="/companies/profile" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.getProfile(): Promise<CompanyProfile>

// { id, name, handle, status, websiteUrl, customizations }`} title="getProfile" />

  <Endpoint method="GET" path="/companies/balance" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.getBalance(): Promise<CompanyBalance>

// { id, name, balanceCents, planId, planExpiresAt }`} title="getBalance" />

  <Endpoint method="PUT" path="/companies/customization" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.updateCustomization({
  brandName?: string,
  logoUrl?: string,
  rectangularLogoUrl?: string,
  squareIconUrl?: string,
  primaryColor?: string,
  faviconUrl?: string,
  websiteUrl?: string,
  welcomeMessage?: string,
}): Promise<CompanyCustomization>`} title="updateCustomization" />

  <Endpoint method="POST" path="/companies/branding" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.uploadBranding({
  squareIcon?: BrandingFile,
  rectangularLogo?: BrandingFile,
}): Promise<CompanyCustomization>

// BrandingFile = { data: Uint8Array, fileName: string, mimeType: string }
// Multipart/form-data upload. Returns the updated customization.`} title="uploadBranding" />

  <Endpoint method="PUT" path="/companies/webhook" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.updateWebhook({
  webhookUrl?: string | null,
  rotateSecret?: boolean,
}): Promise<{ webhookUrl: string | null; webhookSecret: string | null }>

// The secret is returned ONCE. Store it to verify webhook signatures.`} title="updateWebhook" />

  <h3>Company methods — encryption</h3>

  <Endpoint method="PUT" path="/companies/encryption-key" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.registerEncryptionKey({
  keyId: string,
  publicKey: string, // base64 SPKI DER
}): Promise<CompanyEncryptionKey>

// Rotates the active key. The previous key is retired but kept for
// decrypting existing conversations.`} title="registerEncryptionKey" />

  <Endpoint method="GET" path="/companies/encryption-key" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.getEncryptionKey(): Promise<CompanyEncryptionKey>

// Returns the currently active company encryption key.`} title="getEncryptionKey" />

  <h3>Company methods — conversations</h3>

  <Endpoint method="POST" path="/conversations" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.createConversation({
  contact: {
    externalId: string,
    name?: string,
    metadata?: Record<string, unknown>,
  },
  operator?: {
    uuid?: string,
    name?: string,
    image?: string,
    gravatarHash?: string,
  },
}): Promise<CreateConversationResult>

// Returns { conversation, contact, deeplink, company, operator }.
// Share the deeplink with the customer on the original channel.`} title="createConversation" />

  <Endpoint method="PUT" path="/conversations/{conversationId}/operator" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.updateOperator(
  conversationId: string,
  operator: OperatorInput,
): Promise<UpdateOperatorResult>

// OperatorInput = { uuid?, name?, image?, gravatarHash? }
// Pass null to clear a field. Can be called at any time.`} title="updateOperator" />

  <Endpoint method="GET" path="/conversations/{conversationId}/keys" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.getConversationKeys(
  conversationId: string,
): Promise<ConversationKeys>

// { conversationId, keyStatus, operatorPublicKey, operatorKeyId, customerPublicKey }
// keyStatus: 'AWAITING_OPERATOR' | 'AWAITING_CUSTOMER' | 'ACTIVE'
// Poll until keyStatus === 'ACTIVE' and customerPublicKey is set,
// or wait for the CUSTOMER_JOINED webhook.`} title="getConversationKeys" />

  <h3>Company methods — messages</h3>

  <Endpoint method="POST" path="/messages/company" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.sendCompanyMessage(
  conversationId: string,
  envelope: MessageEnvelope,
  contentType?: 'text' | 'react', // default 'text'
  operatorUuid?: string,
  replyToId?: string | null,
  attachments?: string | null, // encrypted JSON
): Promise<Message>

// The envelope must be produced by encryptToRecipient or encryptRichMessage.`} title="sendCompanyMessage" />

  <Endpoint method="GET" path="/messages/{conversationId}" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.listMessages(
  conversationId: string,
): Promise<Message[]>

// Returns all messages (content is always ciphertext when encrypted).
// Each message includes replyTo (one level) and reactions.`} title="listMessages" />

  <Endpoint method="POST" path="/messages/company" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.reactToMessage(
  conversationId: string,
  messageId: string,
  emoji: string, // pass '' to clear
  operatorUuid?: string,
): Promise<Message>

// Encrypts the emoji and sends it as contentType='react' with replyToId.
// Requires operatorKey in the client constructor.`} title="reactToMessage" />

  <Endpoint method="POST" path="/messages/company/read" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.markMessageReadByCompany(
  conversationId: string,
  messageId: string,
): Promise<{ messageId: string; readAt: string }>

// Emits a 'message_read' Socket.io event to the customer.`} title="markMessageReadByCompany" />

  <h3>Company methods — presence</h3>

  <Endpoint method="POST" path="/conversations/{conversationId}/presence" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.reportCompanyPresence(
  conversationId: string,
  type: 'typing' | 'stopped' | 'recording',
): Promise<{ status: string }>

// Relays operator presence to the customer's chat app via Socket.io.`} title="reportCompanyPresence" />

  <h3>Company methods — media</h3>

  <Endpoint method="POST" path="/media/company" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.sendCompanyMedia(
  conversationId: string,
  file: MediaUpload, // { data: Uint8Array, fileName, mimeType }
  envelope: MessageEnvelope,
  operatorUuid?: string,
  replyToId?: string | null,
  attachments?: string | null,
): Promise<Message>

// Multipart/form-data upload. The file must be encrypted with
// encryptMediaToRecipient or encryptMediaWithAttachments.`} title="sendCompanyMedia" />

  <Endpoint method="GET" path="/media/{mediaId}" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.getMedia(mediaId: string): Promise<Media>

// Returns metadata: { id, companyId, conversationId, messageId, mimeType,
// fileName, sizeBytes, iv, authTag, encryptedKey, selfEncryptedKey, keyId, createdAt }`} title="getMedia" />

  <Endpoint method="GET" path="/media/{mediaId}/content" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.downloadCompanyMedia(
  mediaId: string,
): Promise<MediaDownload>

// Returns { data: Uint8Array, media: Media }.
// Decrypt with decryptMediaEnvelope.`} title="downloadCompanyMedia" />

  <h3>Company methods — payments &amp; credits</h3>

  <Endpoint method="POST" path="/companies/credits/purchase" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.purchaseCredits({
  amountCents: number,
  currency?: string,
  provider: string,
  metadata?: Record<string, unknown>,
}): Promise<PurchaseCreditsResult>

// Top up the company's prepaid balance.`} title="purchaseCredits" />

  <Endpoint method="GET" path="/companies/credits/purchases" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.listCreditPurchases(): Promise<CreditPurchase[]>

// Returns all credit purchases with status: PENDING | COMPLETED | FAILED | REFUNDED.`} title="listCreditPurchases" />

  <Endpoint method="GET" path="/companies/payment-methods" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.listPaymentMethods(): Promise<PaymentMethod[]>

// Returns stored cards and Pix methods, default first.
// { id, provider, type, brand, last4, expMonth, expYear, holderName, isDefault, status }`} title="listPaymentMethods" />

  <Endpoint method="GET" path="/companies/payment-change/options" auth="X-API-Key" authType="api-key" />
  <CodeBlock language="typescript" code={`client.getPaymentChangeOptions(): Promise<PaymentChangeOptions>

// { card, pixAutomatic, pixAutomaticCycle, currentPlanExpiresAt,
