---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import PageNav from '../../components/PageNav.astro';
import { t } from '../../i18n';
import type { Locale } from '../../i18n/config';

const locale: Locale = 'en';
---

<DocsLayout>
  <h1>{t(locale, 'nav.integratorRegistration')}</h1>
  <p class="lead">Register your application (CRM, help desk, ticket system) as an integrator to receive API credentials.</p>

  <h2>Registration Endpoint</h2>
  <CodeBlock language="bash" code={`curl -X POST https://api.ixblix.app/api/integrators/register \\
  -H "Content-Type: application/json" \\
  -d '{
    "name": "My CRM Platform",
    "hostname": "mycrm.example.com",
    "callbackUrl": "https://mycrm.example.com/ixblix/callback"
  }'`} title="cURL" />

  <h2>Request Fields</h2>
  <table>
    <thead><tr><th>Field</th><th>Required</th><th>Description</th></tr></thead>
    <tbody>
      <tr><td><code>name</code></td><td>Yes</td><td>Display name of your integrator.</td></tr>
      <tr><td><code>hostname</code></td><td>Yes</td><td>Unique hostname for this integrator. Must be unique across all integrators.</td></tr>
      <tr><td><code>callbackUrl</code></td><td>Yes</td><td>URL where ixblix sends credentials for verification.</td></tr>
      <tr><td><code>force</code></td><td>No</td><td>If true, allows replacing an existing verified hostname registration. Defaults to false.</td></tr>
      <tr><td><code>subscriptionId</code></td><td>No</td><td>Subscription identifier in the format <code>{`{paymentProvider}:{id}`}</code>. The <code>id</code> portion is opaque to the API and interpreted by the payment provider internally. Required when the assigned payment provider needs a subscription reference.</td></tr>
    </tbody>
  </table>

  <h2>Callback Verification Flow</h2>
  <p>Registration happens in three phases:</p>
  <ol>
    <li>You call <code>POST /api/integrators/register</code> with your details.</li>
    <li>ixblix sends a challenge to your <code>callbackUrl</code>:
      <CodeBlock language="json" code={`{
  "challenge": "mycrm.example.com"
}`} title="Challenge payload" />
      Your endpoint must respond with <code>200 OK</code> and the <strong>exact registration payload</strong> you sent in phase 1.
    </li>
    <li>ixblix sends your credentials to the same <code>callbackUrl</code>:
      <CodeBlock language="json" code={`{
  "event": "INTEGRATOR_CREDENTIALS",
  "integratorId": "int_a1b2c3d4-e5f6-7890-abcd-ef1234567890",
  "accessToken": "ixblix_integrator_token_xxxxxxxxxxxx",
  "timestamp": "2026-01-15T10:30:00.000Z"
}`} title="Credentials payload" />
      Your endpoint must echo the credentials payload back with <code>200 OK</code>.
    </li>
  </ol>

  <p>Store the credentials securely — they are used for all subsequent API calls.</p>

  <h2>Using Credentials</h2>
  <p>Use integrator credentials as HTTP Basic Auth:</p>
  <CodeBlock language="bash" code={`curl https://api.ixblix.app/api/plans \\
  -u "int_a1b2c3d4-...:ixblix_integrator_token_xxxx"`} title="cURL" />

  <h2>Callback Handler Example</h2>
  <CodeBlock language="typescript" code={`import express from 'express';
const app = express();
app.use(express.json());

// The registration payload you sent in phase 1
const registrationPayload = {
  name: "My CRM Platform",
  hostname: "mycrm.example.com",
  callbackUrl: "https://mycrm.example.com/ixblix/callback",
};

app.post('/ixblix/callback', async (req, res) => {
  // Phase 2: answer the challenge with the original registration payload
  if (req.body?.challenge) {
    return res.status(200).json(registrationPayload);
  }

  // Phase 3: store credentials and echo them back
  if (req.body?.event === "INTEGRATOR_CREDENTIALS") {
    const { integratorId, accessToken } = req.body;
    await saveIntegratorCredentials({ integratorId, accessToken });
    return res.status(200).json(req.body);
  }

  res.status(200).json({ received: true });
});`} title="Express handler" />

  <PageNav
    prev={{ titleKey: 'nav.quickStart', path: 'quickstart' }}
    next={{ titleKey: 'nav.companyRegistration', path: 'company-registration' }}
  />
</DocsLayout>
