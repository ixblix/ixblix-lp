---
interface Props {
  title: string;
  description?: string;
  locale?: string;
}

import '../assets/style.css';
import { locales } from '../i18n/config';

const { title, description = 'ixblix — Independent commercial messaging platform. Integrate secure, white-labeled conversations into your CRM or help desk.', locale = 'en' } = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {locales.map((l) => {
      const href = l === 'en'
        ? currentPath.replace(/^\/(pt|es)/, '') || '/'
        : currentPath.replace(/^\/(pt|es)/, '') 
          ? `/${l}${currentPath.replace(/^\/(pt|es)/, '')}`
          : `/${l}`;
      return (
        <link rel="alternate" hreflang={l} href={`https://ixblix.app${href}`} />
      );
    })}
    <link rel="alternate" hreflang="x-default" href={`https://ixblix.app${currentPath.replace(/^\/(pt|es)/, '') || '/'}`} />
  </head>
  <body>
    <slot />
  </body>
</html>
