---
import { Code } from 'astro:components';
import { t, getLocaleFromUrl } from '../i18n';
import type { Locale } from '../i18n/config';

interface Props {
  /** The source code to render (server-side highlighted with Shiki). */
  code: string;
  /** Shiki language id. Defaults to `text`. */
  language?: string;
  /** Label shown in the header. Defaults to the language name. */
  title?: string;
  /** Shiki theme. Defaults to the branded dark theme. */
  theme?: string;
}

const {
  code,
  language = 'text',
  title,
  theme = 'github-dark-default',
} = Astro.props;

const locale = getLocaleFromUrl(Astro.url) as Locale;
const copyLabel = t(locale, 'common.copy');
const copiedLabel = t(locale, 'common.copied');
---

<div class="code-block-wrapper">
  <div class="code-block-header">
    <span class="code-block-title">{title ?? language}</span>
    <button class="code-block-copy" type="button" data-copy={copyLabel} data-copied={copiedLabel}>
      {copyLabel}
    </button>
  </div>
  <Code code={code} lang={language} theme={theme} />
</div>

<script>
  document.querySelectorAll('.code-block-copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      const pre = btn.closest('.code-block-wrapper')?.querySelector('pre code');
      if (!pre) return;
      const text = pre.textContent ?? '';
      navigator.clipboard.writeText(text).then(() => {
        const original = btn.textContent;
        btn.textContent = (btn as HTMLElement).dataset.copied ?? 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 2000);
      });
    });
  });
</script>
